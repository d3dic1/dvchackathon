{
  "name": "flickcade",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"tsx watch server/index.ts\" \"vite --host 0.0.0.0 --port 5000\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --host 0.0.0.0 --port 5000",
    "build": "vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "start": "NODE_ENV=production node dist/server/index.js"
  },
  "dependencies": {
    "@clerk/backend": "^3.13.1",
    "@clerk/clerk-react": "^5.61.9",
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^8.2.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
